{
  "name": "@power-grid/cf-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Power Grid game server on Cloudflare Workers + Durable Objects + D1, built with Effect 4",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply powergrid --local",
    "db:migrate:remote": "wrangler d1 migrations apply powergrid --remote",
    "seed:build": "node scripts/build-seed.ts",
    "cf-typegen": "wrangler types",
    "test:unit": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build": "wrangler deploy --dry-run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "sim": "node src/sim/cli.ts"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.0.0",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.83.0",
    "@types/node": "^24.19.1"
  }
}
